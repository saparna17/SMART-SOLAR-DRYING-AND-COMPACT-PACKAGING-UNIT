#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include "Adafruit_SHT31.h"

// ===============================
// WiFi
// ===============================
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// ===============================
// SHT31 Sensor
// ===============================
Adafruit_SHT31 sht31 = Adafruit_SHT31();

// ===============================
// ESP32 Pins
// ===============================
#define HEATER_PIN 26
#define EXHAUST_FAN_PIN 27

// ===============================
// Drying Parameters
// ===============================
float targetTemp = 45.0;
float targetHumidity = 60.0;

float tempHysteresis = 2.0;
float humidityHysteresis = 5.0;

float maximumTemperature = 50.0;

// ===============================
// Sensor Values
// ===============================
float temperature = 0;
float humidity = 0;

bool heaterStatus = false;
bool fanStatus = false;

WebServer server(80);


// ===============================
// SETUP
// ===============================
void setup() {

  Serial.begin(115200);

  pinMode(HEATER_PIN, OUTPUT);
  pinMode(EXHAUST_FAN_PIN, OUTPUT);

  digitalWrite(HEATER_PIN, LOW);
  digitalWrite(EXHAUST_FAN_PIN, LOW);

  // Start I2C
  Wire.begin();

  // Start SHT31
  if (!sht31.begin(0x44)) {

    Serial.println("SHT31 sensor not found!");

    while (1) {
      delay(1000);
    }
  }

  Serial.println("SHT31 Sensor Connected");

  // ===============================
  // WiFi Connection
  // ===============================

  WiFi.begin(ssid, password);

  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected!");

  Serial.print("ESP32 IP Address: ");
  Serial.println(WiFi.localIP());

  // Web server
  server.on("/", handleRoot);

  server.begin();

  Serial.println("Web Server Started");
}


// ===============================
// LOOP
// ===============================
void loop() {

  // Read sensors
  temperature = sht31.readTemperature();
  humidity = sht31.readHumidity();

  // Check sensor error
  if (isnan(temperature) || isnan(humidity)) {

    Serial.println("Sensor reading failed!");

    digitalWrite(HEATER_PIN, LOW);
    digitalWrite(EXHAUST_FAN_PIN, LOW);

    heaterStatus = false;
    fanStatus = false;

    delay(2000);

    return;
  }


  // ===============================
  // TEMPERATURE CONTROL
  // ===============================

  // Safety shutdown
  if (temperature >= maximumTemperature) {

    digitalWrite(HEATER_PIN, LOW);

    heaterStatus = false;

    Serial.println("WARNING: OVER TEMPERATURE!");
  }

  // Heater ON
  else if (temperature <= (targetTemp - tempHysteresis)) {

    digitalWrite(HEATER_PIN, HIGH);

    heaterStatus = true;
  }

  // Heater OFF
  else if (temperature >= (targetTemp + tempHysteresis)) {

    digitalWrite(HEATER_PIN, LOW);

    heaterStatus = false;
  }


  // ===============================
  // HUMIDITY CONTROL
  // ===============================

  // High humidity
  if (humidity >= (targetHumidity + humidityHysteresis)) {

    digitalWrite(EXHAUST_FAN_PIN, HIGH);

    fanStatus = true;
  }

  // Normal humidity
  else if (humidity <= (targetHumidity - humidityHysteresis)) {

    digitalWrite(EXHAUST_FAN_PIN, LOW);

    fanStatus = false;
  }


  // ===============================
  // SERIAL MONITOR
  // ===============================

  Serial.println("-----------------------------");

  Serial.print("Temperature : ");
  Serial.print(temperature);
  Serial.println(" °C");

  Serial.print("Humidity    : ");
  Serial.print(humidity);
  Serial.println(" %");

  Serial.print("Target Temp : ");
  Serial.print(targetTemp);
  Serial.println(" °C");

  Serial.print("Target RH   : ");
  Serial.print(targetHumidity);
  Serial.println(" %");

  Serial.print("Heater      : ");
  Serial.println(heaterStatus ? "ON" : "OFF");

  Serial.print("Exhaust Fan : ");
  Serial.println(fanStatus ? "ON" : "OFF");

  Serial.println("-----------------------------");


  // Handle mobile request
  server.handleClient();

  delay(2000);
}


// ===============================
// MOBILE WEB DASHBOARD
// ===============================
void handleRoot() {

  String page = "";

  page += "<!DOCTYPE html>";
  page += "<html>";
  page += "<head>";

  page += "<meta name='viewport' content='width=device-width, initial-scale=1'>";

  page += "<meta http-equiv='refresh' content='3'>";

  page += "<title>Smart Agarbatti Dryer</title>";

  page += "<style>";

  page += "body{font-family:Arial;text-align:center;background:#f2f2f2;}";

  page += ".box{background:white;margin:20px auto;padding:20px;";
  page += "max-width:400px;border-radius:15px;box-shadow:0 2px 10px #aaa;}";

  page += ".value{font-size:32px;font-weight:bold;}";

  page += ".status{font-size:20px;margin:10px;}";

  page += "</style>";

  page += "</head>";

  page += "<body>";

  page += "<div class='box'>";

  page += "<h1>SMART AGARBATTI DRYER</h1>";

  page += "<h3>Current Drying Profile</h3>";

  page += "<p>Target Temperature: ";
  page += String(targetTemp);
  page += " °C</p>";

  page += "<p>Target Humidity: ";
  page += String(targetHumidity);
  page += " %</p>";

  page += "<hr>";

  page += "<h2>Temperature</h2>";

  page += "<div class='value'>";
  page += String(temperature, 1);
  page += " °C</div>";

  page += "<h2>Humidity</h2>";

  page += "<div class='value'>";
  page += String(humidity, 1);
  page += " %</div>";

  page += "<hr>";

  page += "<div class='status'>Heater: ";

  if (heaterStatus)
    page += "<b>ON</b>";
  else
    page += "<b>OFF</b>";

  page += "</div>";

  page += "<div class='status'>Exhaust Fan: ";

  if (fanStatus)
    page += "<b>ON</b>";
  else
    page += "<b>OFF</b>";

  page += "</div>";

  page += "</div>";

  page += "</body>";
  page += "</html>";

  server.send(200, "text/html", page);
}
